<script>
(() => {
  const wrap = document.querySelector('.k-welding-slider-wrap');
  const track = wrap.querySelector('.k-welding-slider');

  function move(dir) {
    const img = track.querySelector('img');
    if (!img) return;
    const step = img.getBoundingClientRect().width + 14;
    const max = track.scrollWidth - track.clientWidth;
    let dest = track.scrollLeft + dir * step;
    if (dest > max - 5) dest = 0;
    if (dest < 0) dest = max;
    track.scrollTo({left: dest, behavior: 'smooth'});
  }

  wrap.querySelector('.prev').addEventListener('click', () => move(-1));
  wrap.querySelector('.next').addEventListener('click', () => move(1));

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const interval = setInterval(() => move(1), 5000);
    const pause = () => clearInterval(interval);
    wrap.addEventListener('mouseenter', pause, {once:true});
    wrap.addEventListener('pointerdown', pause, {once:true});
    wrap.addEventListener('focusin', pause, {once:true});
  }
})();
</script>
